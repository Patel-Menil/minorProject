# Backend API: validation + forwarding to the model service. Standard library only, no data.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8
WORKDIR /app
COPY services/backend.py services/backend.py

RUN useradd --create-home --uid 10001 app
USER app
EXPOSE 8000
CMD ["python", "services/backend.py"]
